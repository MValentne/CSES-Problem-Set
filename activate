# Sourcing this file prepends the project's scripts/ directory to the PATH
# and enables the `test` command (which needs a wrapper because `test` is a
# shell builtin). Usage: source activate   (or: . activate)

# Resolve the absolute path of the project root relative to this script
ACTIVATE_DIR="$( cd "$( dirname "${BASH_SOURCE[0]:-$0}" )" && pwd )"

if [[ ":$PATH:" != *":$ACTIVATE_DIR/scripts:"* ]]; then
    export PATH="$ACTIVATE_DIR/scripts:$PATH"
    echo -e "\e[32mCSES Testing Environment activated!\e[0m"
    echo -e "Commands available: \e[1mbuild\e[0m, \e[1mtest\e[0m, \e[1mrun\e[0m"
else
    echo -e "\e[33mCSES Testing Environment is already active.\e[0m"
fi

# Enable the `test` command (idempotent)
source "$ACTIVATE_DIR/scripts/_test_wrapper.sh"
