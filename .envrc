# direnv configuration for CSES Problem Set
# Adds scripts/ to the PATH automatically when entering the project directory.
PATH_add scripts

# Enable the `test` command (`test` is a shell builtin, so it needs a wrapper).
# direnv propagates exported functions back to your shell.
if [ -n "${BASH_VERSION:-}" ]; then
    source scripts/_test_wrapper.sh
    export -f test 2>/dev/null || true
fi
