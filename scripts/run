#!/usr/bin/env bash

# run - Execute the compiled binary for the current CSES problem
# Usage: run (from within any problem directory)
# Author: Antigravity

set -euo pipefail

# ANSI color codes (only when outputting to a terminal)
if [ -t 1 ]; then
    COLOR_RED=$'\e[31m'
    COLOR_GREEN=$'\e[32m'
    COLOR_YELLOW=$'\e[33m'
    COLOR_CYAN=$'\e[36m'
    COLOR_RESET=$'\e[0m'
else
    COLOR_RED=""
    COLOR_GREEN=""
    COLOR_YELLOW=""
    COLOR_CYAN=""
    COLOR_RESET=""
fi

# Determine source file and compiler (C or C++)
if [ -f "main.cpp" ]; then
    SRC_FILE="main.cpp"
    COMPILER="g++"
    COMPILER_FLAGS=(-Wall -Wextra -std=c++17 -g)
elif [ -f "main.c" ]; then
    SRC_FILE="main.c"
    COMPILER="gcc"
    COMPILER_FLAGS=(-Wall -Wextra -std=c11 -g)
else
    echo "${COLOR_RED}Error: main.c or main.cpp not found in the current directory (${PWD}).${COLOR_RESET}" >&2
    echo "${COLOR_YELLOW}Run this command from within a problem directory.${COLOR_RESET}" >&2
    exit 1
fi

BIN=".build/main"

# If the binary doesn't exist yet, offer to compile first
if [ ! -f "$BIN" ]; then
    echo "${COLOR_YELLOW}Binary not found. Compiling $SRC_FILE first...${COLOR_RESET}"
    mkdir -p .build
    if ! "$COMPILER" "${COMPILER_FLAGS[@]}" "$SRC_FILE" -o "$BIN"; then
        echo "${COLOR_RED}Compilation failed!${COLOR_RESET}" >&2
        exit 1
    fi
    echo "${COLOR_GREEN}Compilation successful!${COLOR_RESET}"
    echo ""
fi

echo "${COLOR_CYAN}Running ${PWD##*/}${COLOR_RESET} — type your input below (Ctrl+D to finish):"
echo ""

exec "$BIN"
