#!/usr/bin/env bash

# run - Execute the compiled binary for the current CSES problem
#
# Usage:
#   run                interactive mode (type input, Ctrl+D to finish)
#   run tests/3.in     feed a specific input file
#   run <args...>      any extra args are passed to your program
#
# The binary is rebuilt automatically if main.cpp/main.c changed.

set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_lib.sh"

INPUT_FILE=""
ARGS=()
while [ $# -gt 0 ]; do
    if [ -z "$INPUT_FILE" ] && [[ "$1" == *.in ]] && [ -f "$1" ]; then
        INPUT_FILE="$1"
    else
        ARGS+=("$1")
    fi
    shift
done

_ensure_binary   # rebuilds automatically if source is newer than the binary

if [ -n "$INPUT_FILE" ]; then
    .build/main "${ARGS[@]}" < "$INPUT_FILE"
else
    printf '%sRunning %s%s%s — type your input below (Ctrl+D to finish):%s\n\n' \
        "$C_CYAN" "$C_BOLD" "${PWD##*/}" "$C_RESET" "$C_RESET"
    .build/main "${ARGS[@]}"
fi
